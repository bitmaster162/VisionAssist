{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visionassist.market_observation.v1",
  "title": "VisionAssist Trading-Agent Market Observation",
  "description": "Grounded visual market evidence adapted from the VisionAssist visual-semantic cognition contract. This record never authorizes trading or capital use.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "visionassist.market_observation.v1"
    },
    "module_identity": {
      "type": "string",
      "const": "TRADING_AGENT_VISUAL_PERCEPTION_LAYER"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "modality": {
          "type": "string",
          "enum": [
            "chart_image",
            "dashboard"
          ]
        },
        "captured_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "image_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "source_id",
        "modality",
        "captured_at",
        "image_sha256"
      ]
    },
    "market_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "$ref": "#/$defs/context_field"
        },
        "venue": {
          "$ref": "#/$defs/context_field"
        },
        "timeframe": {
          "$ref": "#/$defs/context_field"
        }
      },
      "required": [
        "symbol",
        "venue",
        "timeframe"
      ]
    },
    "visible_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "const": "VISIBLE_OBSERVATION"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "status",
          "description",
          "evidence_refs"
        ]
      }
    },
    "structure_hypotheses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "const": "HYPOTHESIS"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "counterevidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "invalidation_conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "status",
          "description",
          "confidence",
          "evidence_refs",
          "counterevidence_refs",
          "invalidation_conditions"
        ]
      }
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uncertainties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "alternative_explanations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "REVISE",
            "REJECT",
            "ABSTAIN"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "drift_detected": {
          "type": "boolean"
        },
        "abstention_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "reasons",
        "drift_detected",
        "abstention_reason"
      ]
    },
    "compact_digest": {
      "type": "string",
      "minLength": 1
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision_status": {
          "type": "string",
          "const": "DIAGNOSTIC_ONLY"
        },
        "action_code": {
          "type": "string",
          "const": "NO_ACTION"
        },
        "execution_permission": {
          "type": "string",
          "const": "HOLD"
        },
        "capital_permission": {
          "type": "string",
          "const": "DENY"
        },
        "can_trade": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "decision_status",
        "action_code",
        "execution_permission",
        "capital_permission",
        "can_trade"
      ]
    },
    "scene_graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "visionassist.scene_graph.v1"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "OBSERVATION",
                  "HYPOTHESIS"
                ]
              },
              "semantic_type": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "grounded": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "id",
              "kind",
              "semantic_type",
              "label",
              "evidence_refs",
              "confidence",
              "grounded"
            ]
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "type": "string",
                "enum": [
                  "SUPPORTS",
                  "CONTRADICTS"
                ]
              },
              "from_node_id": {
                "type": "string",
                "minLength": 1
              },
              "to_node_id": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "relation",
              "from_node_id",
              "to_node_id",
              "evidence_refs"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "nodes",
        "edges"
      ]
    },
    "detector_report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "visionassist.market_detector_report.v1"
        },
        "module_identity": {
          "type": "string",
          "const": "MARKET_STRUCTURE_DETECTOR_LAYER"
        },
        "report_id": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "source_binding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "image_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "captured_at": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "source_id",
            "image_sha256",
            "captured_at"
          ]
        },
        "detectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "detector_id": {
                "type": "string",
                "minLength": 1
              },
              "detector_type": {
                "type": "string",
                "enum": [
                  "SFP",
                  "CHOCH",
                  "BOS",
                  "SWEEP_RECLAIM"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "SUPPORTED",
                  "CANDIDATE",
                  "UNKNOWN",
                  "REJECTED"
                ]
              },
              "orientation": {
                "type": "string",
                "enum": [
                  "UPSIDE",
                  "DOWNSIDE",
                  "NEUTRAL",
                  "UNKNOWN"
                ]
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "counterevidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "invalidation_conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "level": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "provenance": {
                    "type": "string",
                    "enum": [
                      "VISIBLE_LABEL",
                      "DERIVED_FROM_VISIBLE_GEOMETRY",
                      "UNKNOWN"
                    ]
                  }
                },
                "required": [
                  "value",
                  "provenance"
                ]
              },
              "abstention_reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "detector_id",
              "detector_type",
              "status",
              "orientation",
              "description",
              "confidence",
              "evidence_refs",
              "counterevidence_refs",
              "invalidation_conditions",
              "level",
              "abstention_reason"
            ]
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "PASS",
                "REVISE",
                "ABSTAIN"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "reasons"
          ]
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "decision_status": {
              "type": "string",
              "const": "DIAGNOSTIC_ONLY"
            },
            "action_code": {
              "type": "string",
              "const": "NO_ACTION"
            },
            "execution_permission": {
              "type": "string",
              "const": "HOLD"
            },
            "capital_permission": {
              "type": "string",
              "const": "DENY"
            },
            "can_trade": {
              "type": "boolean",
              "const": false
            }
          },
          "required": [
            "decision_status",
            "action_code",
            "execution_permission",
            "capital_permission",
            "can_trade"
          ]
        }
      },
      "required": [
        "schema_version",
        "module_identity",
        "report_id",
        "request_id",
        "source_binding",
        "detectors",
        "quality",
        "safety"
      ]
    }
  },
  "$defs": {
    "context_field": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "type": "string",
              "const": "PROVIDED_CONTEXT"
            }
          },
          "required": [
            "value",
            "provenance"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "null"
            },
            "provenance": {
              "type": "string",
              "const": "UNKNOWN"
            }
          },
          "required": [
            "value",
            "provenance"
          ]
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "module_identity",
    "observation_id",
    "request_id",
    "source",
    "market_context",
    "visible_observations",
    "structure_hypotheses",
    "scene_graph",
    "detector_report",
    "counterevidence",
    "uncertainties",
    "alternative_explanations",
    "quality",
    "compact_digest",
    "safety"
  ]
}
