  "acceptance_rules": {
    "canonicalization_contract_must_be_frozen_before_first_receipt": true,
    "track_and_batch_id_must_match_track_batch_mapping": true,
    "top_level_keys_must_equal_exact_common_receipt_fields": true,
    "payload_keys_must_equal_receipt_type_exact_payload_fields": true,
    "nested_list_items_must_equal_the_declared_bracket_path_fields": true,
    "track_specific_order_applies_independently_to_each_case_attempt": true,
    "receipt_order_may_not_be_skipped_or_backfilled_within_case_attempt": true,
    "first_receipt_of_each_case_attempt_previous_external_receipt_sha256_must_be_null": true,
    "first_receipt_type_of_each_case_attempt_must_equal_first_track_specific_order_item": true,
    "every_receipt_must_bind_chain_anchor_package_manifest_sha256": true,
    "each_non_first_receipt_must_bind_previous_external_receipt_in_same_case_attempt": true,
    "cross_case_or_cross_attempt_previous_receipt_links_forbidden": true,
    "all_receipts_after_genesis_must_preserve_track_batch_case_and_attempt_ids": true,
    "case_selection_selected_at_must_not_be_after_its_receipt_created_at": true,
    "case_selection_receipt_created_at_must_not_be_after_any_source_retrieved_at_or_bounded_search_performed_at": true,
    "source_capture_cutoff_must_equal_case_selection_cutoff": true,
    "source_capture_identity_and_applicability_must_equal_case_selection": true,
    "bundle_and_prior_timing_fields_must_equal_case_selection_fields": true,
    "bundle_case_id_instrument_symbol_venue_asset_class_timeframe_capture_mode_and_applicability_matrix_sha256_must_equal_case_selection": true,
    "prior_evidence_binding_capture_mode_and_case_selection_receipt_sha256_must_equal_selection_and_bundle": true,
    "authority_must_equal_receipt_authority_exact": true,
    "failed_attempts_are_append_only": true,
    "revised_bytes_require_new_attempt_id": true,
    "internal_artifact_timestamp_alone_is_not_trusted": true,
    "all_file_hashes_require_post_write_readback": true,
    "missing_required_field_result": "HOLD"
  },
  "track_specific_order": {
    "MARKET-R34-DEV-001": [
      "context_profile_freeze",
      "case_selection_freeze",
      "custody_verification",
      "source_capture",
